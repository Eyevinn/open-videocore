# OSC Personal Access Token — get yours at https://app.osaas.io/settings
OSC_ACCESS_TOKEN=

# Parameter store (eyevinn-app-config-svc instance, created once per installation).
# The instance URL is resolved from PARAMETER_STORE_INSTANCE_NAME via the OSC SDK.
PARAMETER_STORE_API_KEY=
PARAMETER_STORE_INSTANCE_NAME=ovcconfig

# Passwords used when provisioning new stacks
MINIO_ROOT_PASSWORD=
COUCHDB_ADMIN_PASSWORD=

# Optional: HTTP port (default 3000)
# PORT=3000

# Optional: operator-configured TOTAL storage cap in bytes (issue #579, ADR-020).
# A per-deployment cost guardrail — one deployed instance is the tenant. When set
# to a positive integer, ingest that would push the deployment's running storage
# total past this cap is rejected with HTTP 409 { "error": "quota_exceeded" }
# across all ingest paths (direct upload, URL pull, watch-folder accounting).
# Unset / 0 / invalid = no cap (opt-in; behaviour unchanged). Example: 107374182400
# caps the deployment at 100 GiB.
# STORAGE_CAP_BYTES=

# Optional: how often (ms) the off-hot-path reconciliation sweep re-sums the
# source + packaged buckets to correct storage-counter drift / recover after a
# crash (issue #579). Default 21600000 (6h). Only runs when STORAGE_CAP_BYTES set.
# STORAGE_QUOTA_RECONCILE_INTERVAL_MS=21600000

# Watch-folder ingest (opt-in). When 'true', a background service watches the
# provisioned source bucket and turns direct-drop objects (files written to the
# bucket outside the API upload route) into asset records. On Open Source Cloud
# the object-storage endpoint + credentials come from the parameter store once a
# stack is provisioned (POST /api/v1/provision) — no MINIO_URL is required. For
# local dev, set MINIO_URL (below) instead. Primary trigger is MinIO bucket
# events; a polling fallback (WATCH_FOLDER_POLL_INTERVAL_SECONDS, default 30)
# covers backends that do not deliver bucket notifications.
# WATCH_FOLDER_ENABLED=true
# WATCH_FOLDER_POLL_INTERVAL_SECONDS=30

# Local-dev object-storage override. When set, ALL storage resolves to this
# single MinIO endpoint (bypassing the parameter store) and the watch-folder is
# wired from it at boot. Leave unset on Open Source Cloud.
# MINIO_URL=http://localhost:9000
# MINIO_ACCESS_KEY=admin
# MINIO_SECRET_KEY=

# Default Encore profile index used to seed the profile store on first startup /
# bootstrap. Defaults to the Eyevinn encore-test-profiles index when unset.
# ENCORE_PROFILES_URL=https://raw.githubusercontent.com/Eyevinn/encore-test-profiles/refs/heads/main/profiles.yml

# Publicly-reachable base URL of this API. When set, Encore instances spawned by
# the auto-scaler load their profiles from this API's own
# GET /api/v1/profiles/index.yml (operator-managed profiles in CouchDB). When
# unset, they fall back to ENCORE_PROFILES_URL.
# PUBLIC_BASE_URL=https://ovc.example.com

# Optional DIRECT override of the profiles-index URL handed to each auto-scaled
# Encore instance. Highest precedence: wins over both the PUBLIC_BASE_URL
# derivation above and the ENCORE_PROFILES_URL default. Use this to point Encore
# at an exact index URL (e.g. this deployment's own index behind a custom
# hostname) without expressing it as a base-URL derivation.
# ENCORE_PROFILES_URL_OVERRIDE=https://ovc.example.com/api/v1/profiles/index.yml
